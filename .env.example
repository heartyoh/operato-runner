# =============================================================================
# Operato Runner Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
# Choose ONE database configuration below:

# SQLite (Development - Default)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# PostgreSQL (Production - Recommended)
# DATABASE_URL=postgresql+asyncpg://operato:operato123@postgres:5432/operato

# MySQL (Alternative)
# DATABASE_URL=mysql+aiomysql://operato:operato123@mysql:3306/operato

# Memory SQLite (Testing)
# DATABASE_URL=sqlite+aiosqlite:///:memory:

# -----------------------------------------------------------------------------
# Optional: Server Configuration
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY=your-secret-key-here
# REDIS_URL=redis://redis:6379/0
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_SIZE=10485760

# -----------------------------------------------------------------------------
# Optional: External API Keys (if using AI features)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here